{
  "name": "eventosif-v2",
  "version": "2.1.0",
  "main": "index.js",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "test:aleatorio": "jest --randomize",
    "bancada": "jest bancada --testPathIgnorePatterns=/node_modules/ --silent=false"
  },
  "private": true,
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "~1.2.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/bancada/"
    ],
    "testTimeout": 60000
  }
}
